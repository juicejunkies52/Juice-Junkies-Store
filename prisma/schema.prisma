generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  // Nullable so a Google-only account (no password set) can still exist.
  password  String?
  googleId  String?  @unique
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  image       String?
  parentId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  parent      Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryParent")
  products    Product[]
}

model Product {
  id                   String      @id @default(cuid())
  name                 String
  slug                 String      @unique
  description          String?
  price                Float
  compareAtPrice       Float?
  images               String
  inventoryQty         Int         @default(0)
  sku                  String?     @unique
  tags                 String
  status               String      @default("active")
  categoryId           String?
  fulfillmentType      String      @default("manual")
  printfulId           String?
  printfulExtId        String?
  designFiles          String      @default("[]")
  mockupImages         String      @default("[]")
  customImages         Boolean     @default(false)
  featured             Boolean     @default(false)
  featuredOrder        Int         @default(0)
  // Pre-order drops: a small deposit reserves the item now; admin later
  // triggers a balance-due email once it's ready to ship (see Order's
  // isPreOrder/balanceDue fields and /api/preorder/*). preOrderDeposit is
  // nullable so flipping preOrderMode on without setting an amount yet is
  // inert rather than defaulting to some arbitrary number.
  preOrderMode         Boolean     @default(false)
  preOrderDeposit      Float?
  preOrderShipEstimate String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  orderItems           OrderItem[]
  category             Category?   @relation(fields: [categoryId], references: [id])
  variants             Variant[]
}

model Variant {
  id            String      @id @default(cuid())
  productId     String
  size          String?
  color         String?
  price         Float?
  inventoryQty  Int         @default(0)
  sku           String?     @unique
  printfulExtId String?     @unique
  images        String      @default("[]")
  customImages  Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  orderItems    OrderItem[]
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
  id                     String      @id @default(cuid())
  userId                 String?
  // 'pending' -> 'paid' for a normal order. Pre-orders add a step in
  // between: 'pending' -> 'deposit_paid' (reserved, nothing shipped yet)
  // -> 'paid' (balance collected -- from here on identical to a normal
  // paid order, same fulfillment pipeline below).
  status                 String      @default("pending")
  totalAmount            Float
  shippingAddress        String
  billingAddress         String
  stripePaymentIntentId  String?
  fulfillmentStatus      String      @default("unfulfilled")
  shippingMethod         String      @default("standard")
  shippingAmount         Float       @default(0)
  printfulOrderId        String?
  trackingNumber         String?
  trackingUrl            String?
  shippedAt              DateTime?
  estimatedDelivery      DateTime?
  // Pre-order tracking -- see Product.preOrderMode. depositAmount/balanceDue
  // are snapshotted at order-creation time (not re-read from the product),
  // so a later change to the product's deposit setting never retroactively
  // changes what an existing reservation owes.
  isPreOrder             Boolean     @default(false)
  depositAmount          Float?
  balanceDue             Float?
  balanceRequestedAt     DateTime?
  balancePaymentIntentId String?
  // Normal orders get the customer's email from paymentIntent.receipt_email
  // at confirm time and never need to store it separately. A pre-order
  // deposit needs it persisted, though -- the balance-due email has to go
  // out weeks later, long after that PaymentIntent is gone from working
  // memory. Left null for normal orders; only pre-orders populate this.
  customerEmail          String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  user                   User?       @relation(fields: [userId], references: [id])
  items                  OrderItem[]
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  variantId String?
  quantity  Int
  price     Float
  createdAt DateTime @default(now())
  variant   Variant? @relation(fields: [variantId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Newsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EarlyAccess {
  id            String   @id @default(cuid())
  firstName     String
  lastName      String
  email         String
  phone         String?
  size          String
  notifications Boolean  @default(true)
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Testimonial {
  id               String   @id @default(cuid())
  name             String?
  location         String?
  testimonial      String
  productPurchased String?
  rating           Int      @default(5)
  isAnonymous      Boolean  @default(false)
  allowPublic      Boolean  @default(true)
  isApproved       Boolean  @default(false)
  isFeatured       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Memory {
  id           String   @id @default(cuid())
  name         String?
  location     String?
  memory       String
  favoriteSong String?
  memoryType   String   @default("general")
  isAnonymous  Boolean  @default(false)
  isApproved   Boolean  @default(false)
  isFeatured   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model FanArt {
  id           String   @id @default(cuid())
  artistName   String
  title        String
  type         String
  description  String?
  socialHandle String?
  url          String
  fileName     String
  fileSize     Int
  mimeType     String
  isApproved   Boolean  @default(false)
  isFeatured   Boolean  @default(false)
  likes        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Admin {
  id        String         @id @default(cuid())
  username  String         @unique
  password  String
  email     String         @unique
  role      String         @default("admin")
  isActive  Boolean        @default(true)
  lastLogin DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  sessions  AdminSession[]
}

model AdminSession {
  id        String   @id @default(cuid())
  adminId   String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

// Site-wide running total of how many butterflies/999s visitors have flung
// in gravity mode. Single row, always keyed "global".
model FlingCounter {
  id        String   @id @default("global")
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
}

// Signatures left on the hidden "secret wall" easter egg (opened by
// bouncing a butterfly onto a held 999 ten times). x/y are percentages of
// viewport width/height so placement stays consistent across screen sizes.
// v1 of the catch-and-collect easter egg: no accounts, just an anonymous
// per-browser visitor id (random, stored in localStorage) so a collection
// can persist across visits without any login. Deliberately lossy -- it
// won't follow someone across devices or survive clearing site data, and
// Catches start out tied only to an anonymous visitorId. Once that browser
// signs in, matching rows get userId filled in (see /api/creatures/link-
// visitor) so the collection becomes permanent instead of tied to one
// browser's local storage -- visitorId is kept either way as a record of
// where the catch originated.
model CaughtCreature {
  id           String   @id @default(cuid())
  visitorId    String
  userId       String?
  creatureType String
  caughtAt     DateTime @default(now())

  @@unique([visitorId, creatureType])
  @@unique([userId, creatureType])
  @@index([visitorId])
  @@index([userId])
}

// Where a caught creature was last left in the decoration area -- one row
// per creature you own, updated whenever you drag it somewhere new. Same
// anonymous-visitorId-first, userId-once-signed-in pattern as
// CaughtCreature, and for the same reason.
model CreatureDecoration {
  id           String   @id @default(cuid())
  visitorId    String
  userId       String?
  creatureType String
  x            Float
  y            Float
  updatedAt    DateTime @updatedAt

  @@unique([visitorId, creatureType])
  @@unique([userId, creatureType])
  @@index([visitorId])
  @@index([userId])
}

// A background image fully revealed and kept, from destroy mode's
// reveal-through-destruction mechanic (see lib/backgrounds.ts for the
// pool). Same anonymous-visitorId-first, userId-once-signed-in pattern as
// CaughtCreature, and for the same reason -- an unlock should survive a
// signup without losing the browser that actually earned it.
model UnlockedBackground {
  id           String   @id @default(cuid())
  visitorId    String
  userId       String?
  backgroundId String
  unlockedAt   DateTime @default(now())

  @@unique([visitorId, backgroundId])
  @@unique([userId, backgroundId])
  @@index([visitorId])
  @@index([userId])
}

model WallSignature {
  id        String   @id @default(cuid())
  name      String
  x         Float
  y         Float
  color     String   @default("#39ff14")
  createdAt DateTime @default(now())
}

// Site-wide running total of every qualifying "bounce a butterfly on a
// held 999" hit, across everyone, forever -- not just the batches of 10
// that reopen the wall. Same singleton pattern as FlingCounter.
model SecretBounceCounter {
  id        String   @id @default("global")
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
}

// Generic record of a paid digital feature unlock -- not merch-specific,
// so future paid extras (beyond Neon Sketch) can reuse this same table
// instead of each needing their own. Only ever created from the Stripe
// webhook on a confirmed payment_intent.succeeded, never from the client,
// so it can't be granted without an actual completed charge.
model DigitalUnlock {
  id                    String   @id @default(cuid())
  userId                String
  feature               String
  stripePaymentIntentId String?
  unlockedAt            DateTime @default(now())

  @@unique([userId, feature])
  @@index([userId])
}

// One saved drawing per account for the Neon Sketch decoration-area tool.
// Stored as a flattened PNG data URL -- simplest thing that works, no
// stroke-replay complexity needed for a single persisted canvas.
model NeonSketch {
  id        String   @id @default(cuid())
  userId    String   @unique
  imageData String
  updatedAt DateTime @updatedAt
}

// One row per account's personal best on the 999 Flutter mini-game.
// Guest/anonymous scores never land here -- only logged-in accounts can
// hold the global #1 spot and attach a message, same gating as every other
// persistent feature this session (collection, decorations, sketch).
model FlutterScore {
  id        String   @id @default(cuid())
  userId    String   @unique
  name      String
  score     Int
  message   String?
  updatedAt DateTime @updatedAt
}

// One row per account's personal best wave reached in 999 Last Stand.
// Same guest-exclusion rule as every other persistent feature -- only
// logged-in accounts get a leaderboard entry.
model LastStandScore {
  id        String   @id @default(cuid())
  userId    String   @unique
  name      String
  wave      Int
  updatedAt DateTime @updatedAt
}

// One row per account's LIFETIME destruction count in "Smash Juice
// Junkies" -- unlike the other scores above this is cumulative (increments
// every session) rather than a personal best, since it backs an XP/rank
// system that should only ever go up. Same guest-exclusion rule.
model DestroyScore {
  id             String   @id @default(cuid())
  userId         String   @unique
  name           String
  totalDestroyed Int      @default(0)
  updatedAt      DateTime @updatedAt
}

// Full save/continue for "999 Depths" -- visitorId-primary, guest-friendly
// like CaughtCreature/UnlockedBackground (not login-gated like the score
// models above, since a world you dug and built is worth keeping even for
// a casual visitor). World generation is deterministic from `seed`, so we
// only persist the sparse diff against that regenerated baseline rather
// than the whole tile grid -- tileDiffs is a JSON object of
// "<tileIndex>": <tileId> entries for cells that differ from the baseline.
// Walls are immutable in this version (no wall mining/placing), so there's
// nothing to diff there.
model MineWorld {
  id           String   @id @default(cuid())
  visitorId    String   @unique
  userId       String?  @unique
  seed         Int
  width        Int
  height       Int
  tileDiffs    Json
  playerX      Float
  playerY      Float
  inventory    Json
  depthReached Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
